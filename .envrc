# Use macOS system Python to bootstrap Spack (avoids any binary-downloaded runtime).
export SPACK_PYTHON=/usr/bin/python3

# Source Spack if not already in PATH.
if ! command -v spack &>/dev/null; then
  source "$HOME/spack/share/spack/setup-env.sh"
fi

# Trust the Zscaler CA for Spack's curl-based fetches.
export SPACK_CURL_EXTRA_FLAGS="--cacert /usr/local/certs/zscaler/ZscalerRootCertificate-2048-SHA256.pem"

# Auto-activate the Spack environment (Node.js + Python toolchain) when entering this directory.
eval "$(spack env activate --sh .)"
spack install

# Install pnpm locally via npm (scoped to this project, not the system or spack store).
# Version is pinned by the "packageManager" field in package.json.
PNPM_VERSION="$(sed -n 's/.*"packageManager": *"pnpm@\([^"]*\)".*/\1/p' package.json)"
if [ ! -x ".tools/node_modules/.bin/pnpm" ] || \
   [ "$(.tools/node_modules/.bin/pnpm --version 2>/dev/null)" != "$PNPM_VERSION" ]; then
  npm install --prefix .tools --no-save "pnpm@${PNPM_VERSION}"
fi
PATH_add "$PWD/.tools/node_modules/.bin"

# Load local env vars if present (AWS profile, SST stage, etc.)
dotenv_if_exists .env.local

# Load local env vars if present (AWS profile, SST stage, etc.)
dotenv_if_exists .env.local
