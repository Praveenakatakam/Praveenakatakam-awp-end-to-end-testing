<mxCell id="zLocal" value="①  On your machine — local git repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F9F4;strokeColor=#B9D2B9;fontColor=#6B7785;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;dashed=0;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="470" height="1010" as="geometry"/></mxCell>
<mxCell id="zCloud" value="②  Cloud — AWS (the deployed registry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F7FE;strokeColor=#B9C9E8;fontColor=#6B7785;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;dashed=0;arcSize=2;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="1920" height="1010" as="geometry"/></mxCell>

<mxCell id="t" value="LLM Functional Test Generator — Architecture (spec §3.11 · R-115…R-126 · D-50…D-56)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1900" height="32" as="geometry"/></mxCell>
<mxCell id="st" value="Purpose: turn cataloged ODCS contracts + EARS requirements into end-to-end CROSS-SERVICE functional tests (publisher → CDC → consumer). An LLM synthesises a schema-validated test PLAN; a deterministic layer renders it to Vitest. Async job (LLM latency &gt; 29s gateway limit). Generate-and-store only — running the tests is out of scope (D-56)." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5A6B7B;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2300" height="44" as="geometry"/></mxCell>

<mxCell id="dev" value="Developer / CI&#10;triggers a run" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="236" y="200" width="78" height="78" as="geometry"/></mxCell>
<mxCell id="cli" value="generate-tests CLI — --functional&#10;trigger → poll → download → write&#10;(writes files only — never commits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#7F8C9B;fontColor=#232F3E;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="85" y="390" width="380" height="150" as="geometry"/></mxCell>
<mxCell id="tree" value="generated-tests/functional/  — in THIS repo&#10;manifest.json · *.generated.test.ts&#10;committed to git; you review the diff" style="shape=folder;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#3F9142;fontColor=#153B18;fontSize=13;" vertex="1" parent="1"><mxGeometry x="85" y="700" width="380" height="130" as="geometry"/></mxCell>

<mxCell id="apigw" value="API Gateway HTTP API&#10;Lambda authorizer: writer vs reader token" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="640" y="548" width="78" height="78" as="geometry"/></mxCell>
<mxCell id="post" value="functional-gen.handler&#10;POST /generate-functional-tests (writer)&#10;→ 202 + jobId, non-blocking" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1030" y="300" width="78" height="78" as="geometry"/></mxCell>
<mxCell id="worker" value="FunctionalWorker Lambda&#10;async (Event invoke) · 15-min timeout&#10;runs the @registry/functest pipeline:&#10;ground → cache → LLM → validate → emit" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1520" y="548" width="78" height="78" as="geometry"/></mxCell>
<mxCell id="read" value="functional-test-jobs handlers&#10;GET /functional-test-jobs [ /{jobId} | /latest ]  (reader)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1030" y="860" width="78" height="78" as="geometry"/></mxCell>

<mxCell id="bedrock" value="Amazon Bedrock — Claude Sonnet 4.6&#10;@aws-sdk/client-bedrock-runtime · InvokeModel&#10;structured output via forced tool use&#10;auth = worker IAM role (SigV4) · no API key&#10;model id = BEDROCK_MODEL_ID (overridable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F6F3;strokeColor=#01A88D;fontColor=#0B4C41;fontSize=13;arcSize=6;align=center;spacingLeft=8;spacingRight=8;spacingTop=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1980" y="250" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="ddb" value="DynamoDB Registry&#10;catalog + REQ# requirements&#10;+ FJOB#{jobId} (byKind GSI)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4D72F3;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="2360" y="510" width="78" height="78" as="geometry"/></mxCell>
<mxCell id="s3" value="S3 ContractsBucket&#10;functional-tests/{jobId}/artifacts.json&#10;+ plan-cache/{inputHash}.json  (the lockfile)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="2360" y="860" width="78" height="78" as="geometry"/></mxCell>

<mxCell id="e0" value="runs --functional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev" target="cli"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="HTTPS · Cognito token&#10;trigger + poll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="apigw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="writes functional/ tree — you review git diff + commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="tree"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="e3" value="writer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="post"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="reader" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="read"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="async invoke (Event)&#10;{ jobId }" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#C9531B;fontColor=#8A3A12;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="post" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="e6" value="① write FJOB (pending)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="post" target="ddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1069" y="200"/><mxPoint x="2399" y="200"/></Array></mxGeometry></mxCell>
<mxCell id="e9" value="InvokeModel (IAM role · SigV4)&#10;forced tool use → plan JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#01A88D;fontColor=#0B4C41;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.4;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker" target="bedrock"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1582" y="440"/><mxPoint x="2108" y="440"/></Array></mxGeometry></mxCell>
<mxCell id="e8" value="read catalog + reqs · write FJOB status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker" target="ddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2200" y="575"/><mxPoint x="2200" y="537"/></Array></mxGeometry></mxCell>
<mxCell id="e10" value="put artifacts · plan-cache get/put (R-119)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2399" y="660"/></Array></mxGeometry></mxCell>
<mxCell id="e11" value="get job + artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="list / get FJOB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="ddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1092" y="790"/><mxPoint x="2260" y="790"/><mxPoint x="2260" y="565"/></Array></mxGeometry></mxCell>

<mxCell id="legend" value="Async lockfile flow — LLM synthesis is non-deterministic, so it is cached, not re-run:&#10;   ①  CLI --functional  →  POST /generate-functional-tests  →  202 + jobId  (writer; does not block on the LLM)&#10;   ②  Worker (async): load catalog + requirements  →  per requirement: ground → input-hash cache HIT? reuse : LLM synthesise + Ajv-validate + cache  →  emit  →  store artifacts + FJOB status&#10;   ③  CLI polls GET /functional-test-jobs/{jobId} until succeeded  →  download artifacts  →  write generated-tests/functional/  →  you review + commit&#10;R-88 byte-identical determinism is SCOPED OUT of LLM synthesis (D-52); an unchanged input hash reuses the committed plan and re-renders byte-identically (R-119a).  Running the emitted tests stays out of scope (D-56)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#D8C88A;fontColor=#5B4E1F;fontSize=13;align=left;spacingLeft=16;spacingTop=12;verticalAlign=top;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="2420" height="175" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
