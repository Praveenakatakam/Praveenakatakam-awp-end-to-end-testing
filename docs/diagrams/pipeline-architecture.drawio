<mxfile host="app.diagrams.net" type="device"><diagram id="pipeline-arch" name="Pipeline Architecture"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="zCloud3" value="Cloud — AWS (the deployed registry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F7FE;strokeColor=#B9C9E8;fontColor=#6B7785;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;dashed=0;arcSize=2;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="2080" height="1020" as="geometry"/></mxCell><mxCell id="t3" value="Configurable LLM Pipeline — Architecture (configurable-llm-pipeline v0.6.0)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1600" height="32" as="geometry"/></mxCell><mxCell id="st3" value="Purpose: run multi-step LLM experiments (e.g. plan → critique → revise) over grounded requirements, with models and prompts changed at runtime — no redeploy. A legacy prompt-version experiment is the same thing with one step, so both show up together as experiments." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5A6B7B;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="2300" height="44" as="geometry"/></mxCell><mxCell id="functest3" value="@registry/functest — shared pure package (deployed nowhere)&#10;• ground() — requirement must name a cataloged entity, in ≥2 sources, with an API target; else skipped + reason&#10;• PLAN_SCHEMA_V1 (legacy / baseline) · PLAN_SCHEMA_V2 · CRITIQUE_SCHEMA + validators&#10;• emitFunctionalTest() — renders the last plan to a Vitest file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4D72F3;fontColor=#12245A;fontSize=13;dashed=1;arcSize=10;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1060" y="104" width="1000" height="130" as="geometry"/></mxCell><mxCell id="user3" value="Browser — React SPA&#10;Experiments · Pipelines · Prompts · Compare" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="100" y="420" width="78" height="78" as="geometry"/></mxCell><mxCell id="apigw3" value="API Gateway HTTP API&#10;+ Lambda authorizer (reader / writer)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="78" height="78" as="geometry"/></mxCell><mxCell id="crud3" value="pipeline.ts (writer)&#10;POST/PUT/DELETE /pipelines · /prompts&#10;POST /prompts/import-legacy" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="820" y="400" width="78" height="78" as="geometry"/></mxCell><mxCell id="trig3" value="functional-gen.ts (writer)&#10;POST /generate-functional-tests&#10;ground → sample → dry run or start" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="78" height="78" as="geometry"/></mxCell><mxCell id="read3" value="read.ts (reader)&#10;GET /runs · /runs/{id}/steps/{i} · /artifact&#10;GET /experiment-index · /experiment-results&#10;(lazy lease expiry → timed_out)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="820" y="1060" width="78" height="78" as="geometry"/></mxCell><mxCell id="worker3" value="Step worker Lambda&#10;one invocation per step · 900 s timeout" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1340" y="700" width="78" height="78" as="geometry"/></mxCell><mxCell id="bedrock3" value="Amazon Bedrock (Claude)&#10;InvokeModel · forced tool use&#10;tool picked by step outputType" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292E;strokeColor=none;fontColor=#FFFFFF;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1800" y="691" width="300" height="96" as="geometry"/></mxCell><mxCell id="ddb3" value="DynamoDB Registry&#10;PIPELINE · PRMPT / PRMPTVER · PEXP&#10;PRUN + STEP#nn · STEPCACHE · SYSCONFIG" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4D72F3;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1340" y="1060" width="78" height="78" as="geometry"/></mxCell><mxCell id="s33" value="S3 bucket&#10;pipeline-outputs/{runId}/&#10;  {nn}.input.json · {nn}.json · test.generated.ts&#10;prompts/{key}/{version}.txt (&gt; 64 KB)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="2160" y="1060" width="78" height="78" as="geometry"/></mxCell><mxCell id="g1" value="Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user3" target="apigw3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="139" y="739"/></Array></mxGeometry></mxCell><mxCell id="g2" value="writer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw3" target="crud3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="716"/><mxPoint x="700" y="439"/></Array></mxGeometry></mxCell><mxCell id="g3" value="writer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw3" target="trig3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g4" value="reader" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw3" target="read3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="762"/><mxPoint x="700" y="1099"/></Array></mxGeometry></mxCell><mxCell id="g5" value="① write PEXP, then a PRUN per run&#10;② async-invoke step 0 of each run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="trig3" target="worker3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g6" value="async-invoke step n+1 — or, after the last step,&#10;mark the run terminal + emit the test file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker3" target="worker3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="712"/><mxPoint x="1500" y="620"/><mxPoint x="1398" y="620"/></Array></mxGeometry></mxCell><mxCell id="g7" value="system = stored prompt&#10;user = grounded context + prior outputs&#10;(+ output instructions, if opted in)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker3" target="bedrock3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g8" value="input snapshot · output · test file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker3" target="s33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1406" y="940"/><mxPoint x="2199" y="940"/></Array></mxGeometry></mxCell><mxCell id="g9" value="lease · step record&#10;cache · run status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;jumpStyle=arc;jumpSize=10;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker3" target="ddb3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g10" value="ground()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;dashed=1;jumpStyle=arc;jumpSize=10;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="trig3" target="functest3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="878" y="600"/><mxPoint x="1160" y="600"/></Array></mxGeometry></mxCell><mxCell id="g11" value="ground · validate · emit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;dashed=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker3" target="functest3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g12" value="PIPELINE · PRMPT / PRMPTVER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="crud3" target="ddb3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="439"/><mxPoint x="1240" y="1079"/></Array></mxGeometry></mxCell><mxCell id="g13" value="runs · steps · experiments" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="read3" target="ddb3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g14" value="inputs · outputs · artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="read3" target="s33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="859" y="1270"/><mxPoint x="2199" y="1270"/></Array></mxGeometry></mxCell><mxCell id="legend3" value="One step, in order (the step worker, per invocation):&#10;1. run too old? → timed_out  ·  2. read the run + pipeline config  ·  3. write the step lease  ·  4. resolve the prompt version&#10;5. ground the requirement (@registry/functest)  ·  6. build the user message: context + prior outputs (budgeted) + output instructions (opt-in)&#10;7. save the input snapshot to S3  ·  8. step-cache hit? → reuse the output, skip Bedrock  ·  9. call Bedrock  ·  10. validate the output against its schema + grounding&#10;11. store output, cache entry and metrics  ·  12. invoke the next step — or, after the last step, mark the run terminal and emit the test file&#10;&#10;Output types: plan → emit_functional_test_plan (PLAN_SCHEMA_V2, or V1 when planSchema = &quot;v1&quot;)  ·  critique → emit_critique  ·  freeform → no tool, plain text&#10;Dashed arrows = in-process calls into the shared package.  An experiment (PEXP) groups the runs from one press of Run; legacy experiments are listed through the same index." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#D8C88A;fontColor=#5B4E1F;fontSize=13;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="2340" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>