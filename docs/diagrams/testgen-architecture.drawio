<mxfile host="app.diagrams.net" type="device"><diagram id="testgen-arch" name="Test Generator Architecture"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="zLocal" value="①  On your machine — local git repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F9F4;strokeColor=#B9D2B9;fontColor=#6B7785;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;dashed=0;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="470" height="900" as="geometry"/></mxCell><mxCell id="zCloud" value="②  Cloud — AWS (the deployed registry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F7FE;strokeColor=#B9C9E8;fontColor=#6B7785;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;dashed=0;arcSize=2;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="1820" height="900" as="geometry"/></mxCell><mxCell id="t2" value="Test Generator — Architecture (spec §3.9 · R-80…R-93)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1400" height="32" as="geometry"/></mxCell><mxCell id="st2" value="Purpose: auto-generate conformance + cross-app compatibility tests from the contract registry, so one app's schema change can't silently break another. Generation + storage only — actually running the tests is out of scope." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5A6B7B;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="2000" height="44" as="geometry"/></mxCell><mxCell id="testgen" value="@registry/testgen — the shared pure engine  (an npm package, deployed nowhere)&#10;Imported by BOTH the cloud Lambda AND the local CLI (--local) ⇒ one code path, identical &amp; deterministic output, unit-tested offline with zero AWS.&#10;in: contract catalog     →     out: manifest + Vitest test files&#10;• deriveJsonSchema — schema[] → JSON Schema (Ajv)      • checkCompat — every consumer-required prop must exist in the publisher (⊆)&#10;• buildManifest — the source-of-truth JSON            • emit Vitest — *.generated.test.ts files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4D72F3;fontColor=#12245A;fontSize=13;dashed=1;arcSize=10;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="1780" height="180" as="geometry"/></mxCell><mxCell id="dev" value="Developer / CI&#10;triggers a run" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="130" y="440" width="78" height="78" as="geometry"/></mxCell><mxCell id="cli" value="generate-tests CLI&#10;npm run generate-tests&#10;modes: default · --pull · --local&#10;(writes files only — never commits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#7F8C9B;fontColor=#232F3E;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="95" y="590" width="380" height="150" as="geometry"/></mxCell><mxCell id="tree" value="generated-tests/  — in THIS repo&#10;manifest.json · conformance/… · compat/…&#10;committed to git; you review the diff" style="shape=folder;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#3F9142;fontColor=#153B18;fontSize=13;" vertex="1" parent="1"><mxGeometry x="95" y="890" width="380" height="130" as="geometry"/></mxCell><mxCell id="apigw" value="API Gateway HTTP API&#10;Lambda authorizer: writer vs reader token" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="680" y="750" width="78" height="78" as="geometry"/></mxCell><mxCell id="gen" value="generate.handler&#10;POST /generate-tests (writer)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="78" height="78" as="geometry"/></mxCell><mxCell id="read" value="test-artifacts handlers&#10;GET /test-artifacts [ /{id} | /latest ] (reader)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1080" y="1020" width="78" height="78" as="geometry"/></mxCell><mxCell id="creads" value="Registry read API  (upstream)&#10;GET /contracts · /{…}/raw (reader)&#10;source for --local; raw YAML from S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#A9B4C0;fontColor=#4A5560;fontSize=12;dashed=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="1060" width="360" height="110" as="geometry"/></mxCell><mxCell id="ddb" value="DynamoDB Registry&#10;catalog + GEN#{runId} (byKind GSI)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#4D72F3;strokeColor=none;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="2100" y="580" width="78" height="78" as="geometry"/></mxCell><mxCell id="s3" value="S3 ContractsBucket&#10;test-artifacts/{runId}/artifacts.json&#10;(+ raw ODCS YAML)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="2100" y="1020" width="78" height="78" as="geometry"/></mxCell><mxCell id="f0" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev" target="cli"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1" value="HTTPS · Cognito token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="apigw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="565" y="710"/><mxPoint x="565" y="780"/></Array></mxGeometry></mxCell><mxCell id="f2" value="--local: runs the engine in-process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;dashed=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.06;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="testgen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="302"/><mxPoint x="667" y="302"/></Array></mxGeometry></mxCell><mxCell id="f3" value="writes tree — you review git diff + commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="tree"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f4" value="writer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f5" value="reader" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="read"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f6" value="reader (--local)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="creads"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f7" value="generateArtifacts(catalog)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="testgen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1119" y="340"/><mxPoint x="1450" y="340"/></Array></mxGeometry></mxCell><mxCell id="f8" value="read catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddb" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f9" value="write GEN run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="ddb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f10" value="put artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.95;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="634"/><mxPoint x="1260" y="880"/><mxPoint x="2020" y="880"/></Array></mxGeometry></mxCell><mxCell id="f11" value="get artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f12" value="list / get runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="ddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="940"/><mxPoint x="2139" y="940"/></Array></mxGeometry></mxCell><mxCell id="f13" value="reads contracts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#5A6B7B;fontColor=#233240;fontSize=13;labelBackgroundColor=#FFFFFF;spacingTop=2;spacingBottom=2;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="creads" target="ddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="1200"/><mxPoint x="2260" y="1200"/><mxPoint x="2260" y="619"/></Array></mxGeometry></mxCell><mxCell id="legend" value="The three CLI modes  ·  every mode ends by writing generated-tests/, which you then review &amp; commit  ·  dashed arrows = the --local path&#10;   default   →   POST /generate-tests  (generate in the cloud)   →   GET /test-artifacts/latest  (pull the result)   →   write tree&#10;   --pull    →   GET /test-artifacts/latest  (pull the last stored run only, no new generation)   →   write tree&#10;   --local   →   GET /contracts + /raw   →   generateArtifacts() on your machine (the SAME engine as the Lambda)   →   write tree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#D8C88A;fontColor=#5B4E1F;fontSize=13;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="2320" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>