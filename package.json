{
  "name": "odcs-contract-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "sst dev",
    "deploy": "sst deploy",
    "remove": "sst remove",
    "typecheck": "tsc --noEmit && tsc -p packages/web/tsconfig.json --noEmit",
    "test": "sst bind vitest run",
    "test:offline": "vitest run",
    "test:web": "npm --workspace @registry/web test",
    "test:all": "npm run test:offline && npm run test:web",
    "generate-tests": "sst bind tsx scripts/generate-tests.ts"
  },
  "overrides": {
    "@smithy/types": "4.15.1",
    "@smithy/config-resolver": "4.4.0",
    "@babel/core": "7.29.6",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "adm-zip": "0.6.0",
    "ajv": "8.18.0",
    "axios": "1.16.0",
    "brace-expansion": "2.0.3",
    "diff": "8.0.3",
    "esbuild": "0.25.0",
    "fast-jwt": "6.2.4",
    "fast-uri": "3.1.2",
    "fast-xml-parser": "5.10.1",
    "flatted": "3.4.2",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "kysely": "0.28.17",
    "minimatch": "10.2.3",
    "picomatch": "2.3.2",
    "tmp": "0.2.6",
    "undici": "6.27.0",
    "uuid": "11.1.1",
    "yaml": "2.8.3",
    "sst": {
      "aws-cdk-lib": "2.261.0",
      "ajv": "8.18.0",
      "fast-uri": "3.1.2",
      "fast-xml-parser": "5.10.1",
      "kysely": "0.28.17"
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.16.2",
    "aws-cdk-lib": "^2.246.0",
    "constructs": "^10.5.0",
    "sst": "^2.43.7",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  }
}
