{
  "name": "ict-cdk-ts-template",
  "private": true,
  "version": "0.1.0",
  "bin": {
    "cdk": "bin/cdk.js"
  },
  "engines": {
    "node": ">= 20.0.0",
    "pnpm": ">= 9.0.0"
  },
  "author": "",
  "pre-commit": [
    "lint"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "pnpm eslint .",
    "test:unit": "jest",
    "build:nx": "pnpm exec nx run-many -t build",
    "release": "pnpm exec nx release --skip-publish",
    "cdk": "cdk",
    "prepush": "pnpm run format:check && pnpm run lint && pnpm run test:unit ",
    "format:fix": "pnpm exec prettier --write lib/**/*.ts bin/**/*.ts",
    "format:check": "pnpm exec prettier --check lib/**/*.ts bin/**/*.ts",
    "prepare": "husky && pnpm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.8.0",
    "@jest/globals": "^29.7.0",
    "@jest/types": "^29.6.3",
    "@tsconfig/node20": "^20.1.4",
    "@tsconfig/strictest": "^2.0.5",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.12",
    "@types/node": "20.12.7",
    "aws-cdk": "^2.151.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.7",
    "pre-commit": "^1.2.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.0.0",
    "@nx/eslint": "19.5.7",
    "@nx/jest": "19.5.7",
    "@nx/js": "19.5.7",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "nx": "19.5.7"
  },
  "dependencies": {
    "aws-cdk-lib": "2.147.2",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  },
  "lint-staged": {
    "**/*": "pnpm exec prettier --write lib/**/*.ts bin/**/*.ts --ignore-unknown"
  },
  "nx": {}
}
