{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "sst.config.ts",
    "stacks/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    ".sst/types/**/*.ts"
  ],
  "exclude": ["node_modules", "packages/web", "generated-tests"]
}
